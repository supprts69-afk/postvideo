 # ---- Telegram ----
TG_API_ID=1234567
TG_API_HASH=your_api_hash
# User-mode (channel dekhar jonno) -> make_session.py theke. Shudhu bot use korle faka rakho.
TG_SESSION=
# Bot-mode (tomar nijer bot) -> @BotFather theke token. Bot na thakle faka rakho.
TG_BOT_TOKEN=

# Je source gulo dekhbe (ek line JSON). author_id = profiles.id
#  via=user (default): "chat" = @username ba numeric id. Tomar account oi channel/bot chat-e thakte hobe.
#  via=bot: bot-e message/forward korle post hobe. allowed_senders = tomar Telegram user id
#           (bot-ke /id likhle bole dey). allowed_chats = channel/group id jekhane bot admin. Dutor ekta dewa must.
TG_SOURCES=[{"via":"bot","author_id":"7630fbd6-818a-4945-8fa5-e2c6dc735860","allowed_senders":[123456789],"ai_rewrite":false},{"chat":"@my_test_channel","author_id":"7630fbd6-818a-4945-8fa5-e2c6dc735860","ai_rewrite":false}]

# ---- Supabase ----
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://nwzocbjnfchdtvsnzgfd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET=media

# ---- Behaviour ----
DRY_RUN=true            # true = shudhu log dekhabe, DB/bucket-e kichhu likhbe na. Thik hole false koro
MAX_UPLOAD_MB=50        # Supabase limit-er beshi hole video skip hobe
BACKFILL_LIMIT=0        # prothom bar purono koyta post tulbe (0 = shudhu notun)
CONTENT_SOURCE_VALUE=external

# ---- AI (optional, key na dile AI use hobe na) ----
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
